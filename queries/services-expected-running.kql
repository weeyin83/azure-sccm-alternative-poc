// Purpose: reconcile service inventory and later changes for explicitly expected services.
// Sources: ConfigurationData and ConfigurationChange. Output: stopped, stale, ambiguous or unknown services.
// Populate one row per approved server/service pair; an empty list intentionally returns no records.
let ExpectedServices = datatable(ResourceId:string, SvcName:string)[];
let HistoryStart = ago(2d);
let FreshnessCutoff = ago(1h);
let Expected =
    ExpectedServices
    | extend ResourceId = tolower(ResourceId), ServiceKey = tolower(SvcName)
    | distinct ResourceId, ServiceKey;
let Observations = materialize(
    union
        (ConfigurationData
        | where TimeGenerated >= HistoryStart and ConfigDataType == "WindowsServices"
        | project TimeGenerated, ResourceId = tolower(_ResourceId), Computer, SvcName, SvcState, SvcStartupType),
        (ConfigurationChange
        | where TimeGenerated >= HistoryStart and ConfigChangeType == "WindowsServices"
        | project TimeGenerated, ResourceId = tolower(_ResourceId), Computer, SvcName, SvcState, SvcStartupType)
    | where isnotempty(ResourceId) and isnotempty(SvcName)
    | extend ServiceKey = tolower(SvcName)
    | join kind=inner Expected on ResourceId, ServiceKey
    | project TimeGenerated, ResourceId, ServiceKey, Computer, SvcState, SvcStartupType
);
let LatestState =
    Observations
    | where isnotempty(SvcState)
    | summarize States = make_set(tolower(SvcState), 2), Computer = take_any(Computer)
        by ResourceId, ServiceKey, TimeGenerated
    | summarize arg_max(TimeGenerated, States, Computer) by ResourceId, ServiceKey
    | project ResourceId, ServiceKey, Computer, States, StateObserved = TimeGenerated;
let LatestStartup =
    Observations
    | where isnotempty(SvcStartupType)
    | summarize StartupTypes = make_set(tolower(SvcStartupType), 2)
        by ResourceId, ServiceKey, TimeGenerated
    | summarize arg_max(TimeGenerated, StartupTypes) by ResourceId, ServiceKey
    | project ResourceId, ServiceKey, StartupTypes, StartupObserved = TimeGenerated;
Expected
| join kind=leftouter LatestState on ResourceId, ServiceKey
| join kind=leftouter LatestStartup on ResourceId, ServiceKey
| extend MonitoringState = case(
    isnull(StateObserved), "Unknown: no state in history",
    array_length(States) != 1, "Unknown: conflicting state observations",
    StateObserved > now(), "Unknown: future state observation",
    StateObserved < FreshnessCutoff, "Unknown: stale state",
    tostring(States[0]) == "running", "Running",
    "Not running")
| where MonitoringState != "Running"
| project ResourceId, Computer, SvcName = ServiceKey, MonitoringState,
    ObservedStates = States, StateObserved, ObservedStartupTypes = StartupTypes, StartupObserved
| order by ResourceId asc, SvcName asc
