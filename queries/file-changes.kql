// Purpose: investigate collected file changes on selected servers.
// Source: Log Analytics ConfigurationChange. Output: time, server, path and change.
// Populate with approved Arc resource IDs; an empty list intentionally returns no records.
let ServerIds = dynamic([]);
ConfigurationChange
| where TimeGenerated >= ago(7d)
| where _ResourceId in~ (ServerIds)
| where ConfigChangeType == "Files"
| project TimeGenerated, ResourceId = _ResourceId, Computer, FileSystemPath, ChangeCategory, FieldsChanged
| order by TimeGenerated desc
