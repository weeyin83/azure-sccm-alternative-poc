// Purpose: report missing/stale heartbeats for servers explicitly expected online.
// Source: expected-server list joined to Log Analytics Heartbeat. Output: missing monitoring evidence.
// Use the latest expected-online start time; deliberately powered-off servers must be excluded.
let ExpectedServers = datatable(ResourceId:string, ExpectedOnlineSince:datetime)[];
let HistoryStart = ago(1d);
let MissingCutoff = ago(15m);
let OnboardingCutoff = ago(15m);
let LatestHeartbeat =
    Heartbeat
    | where TimeGenerated >= HistoryStart
    | summarize LastHeartbeat = max(TimeGenerated) by ResourceId = tolower(_ResourceId);
ExpectedServers
| extend ResourceId = tolower(ResourceId)
| join kind=leftouter LatestHeartbeat on ResourceId
| extend MonitoringState = case(
    isempty(ResourceId) or isnull(ExpectedOnlineSince) or ExpectedOnlineSince > now(),
        "Invalid expected-online configuration",
    ExpectedOnlineSince > OnboardingCutoff, "Onboarding grace",
    LastHeartbeat > now(), "Unknown: future heartbeat",
    isnull(LastHeartbeat) or LastHeartbeat < ExpectedOnlineSince, "No heartbeat observed in available history during expected-online period",
    LastHeartbeat < MissingCutoff, "Stale heartbeat",
    "Heartbeat observed")
| where MonitoringState !in ("Onboarding grace", "Heartbeat observed")
| project ResourceId, ExpectedOnlineSince, LastHeartbeat, MonitoringState
| order by ResourceId asc
