// Purpose: investigate observed software additions on selected servers.
// Source: Log Analytics ConfigurationChange. Output: addition time, server, name and publisher.
// Populate with approved Arc resource IDs; an empty list intentionally returns no records.
let ServerIds = dynamic([]);
ConfigurationChange
| where TimeGenerated >= ago(7d)
| where _ResourceId in~ (ServerIds)
| where ConfigChangeType == "Software" and ChangeCategory == "Added"
| project TimeGenerated, ResourceId = _ResourceId, Computer, SoftwareName, Publisher, ChangeCategory
| order by TimeGenerated desc
